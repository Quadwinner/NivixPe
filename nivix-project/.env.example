# ── Nivix local dev environment ──
# Copy to .env (which is gitignored) and fill values. NEVER commit real secrets.

NODE_ENV=development

# API
API_PORT=3002

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://nivix:nivix_local_dev@localhost:5432/nivix?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_me_local_dev_only
JWT_EXPIRES_IN=15m

# Local encryption master key — DEV ONLY (KMS replaces this on AWS).
# Generate with: openssl rand -base64 32
LOCAL_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES

# Hosting providers: 'env' locally, 'aws' later (config-only swap)
SECRETS_PROVIDER=env

# KYC vendor (sandbox) — set in Week 1
KYC_VENDOR=sumsub
KYC_API_TOKEN=
KYC_WEBHOOK_SECRET=

# Hyperledger Fabric (local test-network, Org1) — wired in WS-C
FABRIC_GATEWAY_PEER_ENDPOINT=localhost:7051
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=nivix-kyc
